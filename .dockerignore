# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# Data
data/
*.db

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp

# Tests
tests/
frontend/src/test/
# Co-located test files (kept out of the image like src/test/). Without this the
# tsc step in the frontend build stage compiles a stray *.test.tsx whose vitest
# matcher types come from the excluded src/test/setup.ts, breaking the build.
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx

# Docs
*.md
!README.md
!LICENSES.md

# Other
references/
*.pem
.env*
